{
  "protocol_version": "enpda-validation-pilot-v1-2026-08-29",
  "exploratory_validation_only": true,
  "scientific_question": "Can a shared equivariant primal-dual auction learn better fixed-depth one-shot MCES proposals than the identical analytic auction?",
  "parent_split_manifest": "results/hard_self_distill_pilot/manifest.json",
  "teacher_pattern": "results/hard_self_distill_pilot/teachers/seed{seed}.jsonl",
  "datasets": ["AIDS", "MOLHIV", "MCF-7"],
  "model": {
    "steps": 4,
    "hidden_dim": 64,
    "message_layers": 2,
    "base_primal_step": 0.5,
    "base_dual_step": 0.5,
    "incompatibility_penalty": 8.0,
    "initial_dummy_logit": -1.0
  },
  "training": {
    "epochs": 6,
    "learning_rate": 0.0003,
    "weight_decay": 0.00001,
    "gradient_accumulation": 8,
    "gradient_clip_norm": 2.0,
    "train_pairs_per_dataset": 200,
    "teacher_nll_weight": 1.0,
    "intermediate_nll_weight": 0.25,
    "analytic_margin_weight": 0.5,
    "analytic_nll_margin": 0.01,
    "soft_objective_weight": 0.05,
    "capacity_penalty_weight": 0.1,
    "price_penalty_weight": 0.0001
  },
  "validation": {
    "pairs_per_dataset": 30,
    "step_budgets": [1, 2, 4],
    "checkpoint_epochs": [0, 2, 4, 6],
    "primary_control": "analytic",
    "rounding": "one partial Hungarian projection; no discrete refinement",
    "selection_metric": "held-out-training mean normalized hard-edge advantage over the identical analytic primal-dual auction",
    "pass_rule": "positive aggregate advantage, positive mean on every dataset, and at least two positive step budgets per dataset"
  },
  "smoke": {
    "epochs": 3,
    "train_pairs_per_dataset": 12,
    "pairs_per_dataset": 6,
    "step_budgets": [1, 2]
  },
  "hardware": {
    "accelerator_any": ["H100", "H200"],
    "cuda_runtime_prefix": "12.8"
  },
  "outputs": {
    "root": "results/enpda_pilot",
    "checkpoint_pattern": "checkpoints/enpda_pilot/seed{seed}.best.pt",
    "result_pattern": "results/enpda_pilot/seed{seed}.json",
    "smoke_root": "results/enpda_pilot/smoke"
  }
}
